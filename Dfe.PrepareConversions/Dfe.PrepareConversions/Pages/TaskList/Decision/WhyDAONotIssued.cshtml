@page "/task-list/{id:int}/decision/why-dao-not-issued"
@using Dfe.PrepareConversions.Data.Models.AdvisoryBoardDecision
@using Dfe.Academisation.ExtensionMethods
@using Dfe.PrepareConversions.Extensions
@model Dfe.PrepareConversions.Pages.TaskList.Decision.WhyDAONotIssuedModel
@{
   ViewData["Title"] = "Why was a Directive Academy Order (DAO) not issued?";
   Layout = "_Layout";
}

@section BeforeMain
{
   <partial name="_BackLink" model="@Model.BackLinkModel"/>
   <partial name="_ErrorSummary"/>
}

<span id="selection-span" class="govuk-caption-l">Record the decision</span>
<h1 class="govuk-heading-l">Why was a Directive Academy Order (DAO) not issued for this project?</h1>

<form method="post">
   <div class="govuk-form-group">
      <fieldset class="govuk-fieldset">
         <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
         </legend>
         <div class="govuk-checkboxes @ModelState.GetErrorStyleClass()" data-module="govuk-checkboxes" id="WasReasonGiven">

            <input type="hidden" asp-for="@Model.WasReasonGiven"/>

            @{
               CheckBoxAndLabel(AdvisoryBoardDAONotIssuedReason.SchoolWouldNotBeViableAsAnAcademy,
                  Model.SchoolWouldNotBeViableAsAnAcademyIsChecked,
                  Model.SchoolWouldNotBeViableAsAnAcademyDetails);
               CheckBoxAndLabel(AdvisoryBoardDAONotIssuedReason.ThereAreNoSuitableTrustOptions,
                  Model.ThereAreNoSuitableTrustOptionsIsChecked,
                  Model.ThereAreNoSuitableTrustOptionsDetails);
               CheckBoxAndLabel(AdvisoryBoardDAONotIssuedReason.SchoolAlreadyConvertingAndSufficientlyAdvanced,
                    Model.SchoolAlreadyConvertingAndSufficientlyAdvancedIsChecked,
                  Model.SchoolAlreadyConvertingAndSufficientlyAdvancedDetails);
               CheckBoxAndLabel(AdvisoryBoardDAONotIssuedReason.Other, Model.OtherIsChecked, Model.OtherDetails);
            }
         </div>
      </fieldset>
   </div>

   <button class="govuk-button" data-module="govuk-button" id="submit-btn">
      Continue
   </button>
</form>

@{
   void CheckBoxAndLabel(AdvisoryBoardDAONotIssuedReason daoNotIssuedReason, bool isChecked, string details)
   {
      <div class="govuk-checkboxes__item" id="@(daoNotIssuedReason)Details">
         <input class="govuk-checkboxes__input"
                id="@daoNotIssuedReason.ToString().ToLower()-checkbox"
                name="@(daoNotIssuedReason)IsChecked"
                type="checkbox"
                data-aria-controls="conditional-@daoNotIssuedReason"
                value="true"
                @(isChecked ? "checked" : "")>
         <label class="govuk-label govuk-checkboxes__label" for="@daoNotIssuedReason.ToString().ToLower()-checkbox">
            @daoNotIssuedReason.ToDescription()
         </label>
      </div>
      <div class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden" id="conditional-@daoNotIssuedReason">
         <div class="govuk-form-group">
            <label class="govuk-label" for="@daoNotIssuedReason.ToString().ToLower()-txtarea">
               Give reasons
            </label>
            <textarea class="govuk-textarea govuk-!-width-three-quarters"
                      id="@daoNotIssuedReason.ToString().ToLower()-txtarea"
                      name="@(daoNotIssuedReason)Details"
                      rows="5"
                      aria-describedby="more-detail-hint">@details</textarea>
         </div>

      </div>
   }
}