@using Dfe.PrepareConversions.ViewModels

@model BannerModel

@if (Model != null && !string.IsNullOrEmpty(Model.Type))
{
   <div class="govuk-notification-banner govuk-notification-banner--@Model.Type" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
      <div class="govuk-notification-banner__header">
         <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
            @Model.Title
         </h2>
      </div>
      <div class="govuk-notification-banner__content">
         <h3 class="govuk-notification-banner__heading" id="notification-message">
            @Model.Heading
         </h3>
         @foreach (var message in Model.Message)
         {
            <p class="govuk-body">@message</p>
         }
      </div>
   </div>
}