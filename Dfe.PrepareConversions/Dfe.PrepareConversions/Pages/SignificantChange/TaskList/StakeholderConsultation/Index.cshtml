@page "/significant-change/task-list/{id:int}/stakeholder-consultation"
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.StakeholderConsultation.IndexModel
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Has the trust consulted stakeholders about the planned significant change?
      </legend>
      <inline-error for="@nameof(Model.TrustConsultedStakeholders)" />

      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="@Model.TrustConsultedStakeholders" class="govuk-radios__input"
                   id="trust-consulted-stakeholders-yes" type="radio" value="true"
                   data-test="trust-consulted-stakeholders-yes" />
            <label class="govuk-label govuk-radios__label" for="trust-consulted-stakeholders-yes">
               Yes
            </label>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.TrustConsultedStakeholders" class="govuk-radios__input"
                   id="trust-consulted-stakeholders-no" type="radio" value="false"
                   aria-controls="conditional-trust-consulted-stakeholders-no"
                   data-test="trust-consulted-stakeholders-no" />
            <label class="govuk-label govuk-radios__label" for="trust-consulted-stakeholders-no">
               No
            </label>
         </div>

         <div class="govuk-radios__conditional" id="conditional-trust-consulted-stakeholders-no">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="TrustConsultedStakeholdersNotConsultedReason">
                  Use this area for additional information relating to mitigations, actions and further investigations.
               </label>
               <inline-error for="@nameof(Model.TrustConsultedStakeholdersNotConsultedReason)" />
               <textarea asp-for="@Model.TrustConsultedStakeholdersNotConsultedReason"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.TrustConsultedStakeholdersNotConsultedReason))"
                         rows="5" data-test="trust-consulted-stakeholders-not-consulted-reason"></textarea>
            </div>
         </div>
      </div>
   </fieldset>
</div>
