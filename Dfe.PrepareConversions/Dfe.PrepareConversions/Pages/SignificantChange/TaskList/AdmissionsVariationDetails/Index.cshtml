@page "/significant-change/task-list/{id:int}/admissions-variation-details"
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.AdmissionsVariationDetails.IndexModel
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Is an admissions variation required for this significant change?
      </legend>
      <inline-error for="@nameof(Model.AdmissionsVariationRequired)" />

      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="AdmissionsVariationRequired" class="govuk-radios__input"
                   id="admissions-variation-required-yes" type="radio" value="true"
                   data-test="admissions-variation-required-yes" />
            <label class="govuk-label govuk-radios__label" for="admissions-variation-required-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="AdmissionsVariationRequired" class="govuk-radios__input"
                   id="admissions-variation-required-no" type="radio" value="false"
                   data-test="admissions-variation-required-no" />
            <label class="govuk-label govuk-radios__label" for="admissions-variation-required-no">No</label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <label class="govuk-label govuk-label--m" for="SupportingEvidence">Supporting evidence</label>
   <input asp-for="SupportingEvidence" class="govuk-input" type="text"
          data-test="admissions-variation-supporting-evidence" />
</div>
