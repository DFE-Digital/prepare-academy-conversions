@page "/significant-change/task-list/{id:int}/admissions-variation-details/support"
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.AdmissionsVariationDetails.SupportModel
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="/SignificantChange/TaskList/AdmissionsVariationDetails/Index" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Is the local authority supportive of the admissions variation?
      </legend>
      <inline-error for="@nameof(Model.LocalAuthoritySupportive)" />
      <div class="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="LocalAuthoritySupportive" class="govuk-radios__input"
                   id="local-authority-supportive-yes" type="radio" value="true"
                   data-test="local-authority-supportive-yes" />
            <label class="govuk-label govuk-radios__label" for="local-authority-supportive-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="LocalAuthoritySupportive" class="govuk-radios__input"
                   id="local-authority-supportive-no" type="radio" value="false"
                   data-test="local-authority-supportive-no" />
            <label class="govuk-label govuk-radios__label" for="local-authority-supportive-no">No</label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Is the Pupil Place Planning Team supportive of the admissions variation?
      </legend>
      <inline-error for="@nameof(Model.PupilPlacePlanningTeamSupportive)" />
      <div class="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="PupilPlacePlanningTeamSupportive" class="govuk-radios__input"
                   id="pupil-place-planning-supportive-yes" type="radio" value="true"
                   data-test="pupil-place-planning-supportive-yes" />
            <label class="govuk-label govuk-radios__label" for="pupil-place-planning-supportive-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="PupilPlacePlanningTeamSupportive" class="govuk-radios__input"
                   id="pupil-place-planning-supportive-no" type="radio" value="false"
                   data-test="pupil-place-planning-supportive-no" />
            <label class="govuk-label govuk-radios__label" for="pupil-place-planning-supportive-no">No</label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Is the Admissions Team supportive of the admissions variation?
      </legend>
      <inline-error for="@nameof(Model.AdmissionsTeamSupportive)" />
      <div class="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="AdmissionsTeamSupportive" class="govuk-radios__input"
                   id="admissions-team-supportive-yes" type="radio" value="true"
                   data-test="admissions-team-supportive-yes" />
            <label class="govuk-label govuk-radios__label" for="admissions-team-supportive-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="AdmissionsTeamSupportive" class="govuk-radios__input"
                   id="admissions-team-supportive-no" type="radio" value="false"
                   data-test="admissions-team-supportive-no" />
            <label class="govuk-label govuk-radios__label" for="admissions-team-supportive-no">No</label>
         </div>
      </div>
   </fieldset>
</div>
