@page "/significant-change/task-list/{id:int}/admissions-variation-details/support"
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.AdmissionsVariationDetails.SupportModel
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="/SignificantChange/TaskList/AdmissionsVariationDetails/Index" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Is the local authority supportive of the admissions variation?
      </legend>
      <inline-error for="@nameof(Model.LocalAuthoritySupportive)" />
      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="LocalAuthoritySupportive" class="govuk-radios__input"
                   id="local-authority-supportive-yes" type="radio" value="true"
                   data-test="local-authority-supportive-yes" />
            <label class="govuk-label govuk-radios__label" for="local-authority-supportive-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="LocalAuthoritySupportive" class="govuk-radios__input"
                   id="local-authority-supportive-no" type="radio" value="false"
                   aria-controls="conditional-local-authority-supportive-no"
                   data-test="local-authority-supportive-no" />
            <label class="govuk-label govuk-radios__label" for="local-authority-supportive-no">No</label>
         </div>
         <div class="govuk-radios__conditional" id="conditional-local-authority-supportive-no">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="LocalAuthoritySupportiveAdditionalInformation">
                  Give details
               </label>
               <inline-error for="@nameof(Model.LocalAuthoritySupportiveAdditionalInformation)" />
               <textarea asp-for="LocalAuthoritySupportiveAdditionalInformation"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.LocalAuthoritySupportiveAdditionalInformation))"
                         rows="5" data-test="local-authority-supportive-additional-information"></textarea>
            </div>
         </div>
      </div>
   </fieldset>
</div>

