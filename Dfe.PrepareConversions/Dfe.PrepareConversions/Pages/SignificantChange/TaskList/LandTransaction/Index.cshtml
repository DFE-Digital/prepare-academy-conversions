@page "/significant-change/task-list/{id:int}/land-transaction"
@using Dfe.PrepareConversions.Data.Models.SignificantChange
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.LandTransaction.IndexModel
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset" data-test="land-transction-application-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Has the landowner submitted a land transaction application?
      </legend>
      <inline-error for="@nameof(Model.LandTransactionApplication)" />

      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="@Model.LandTransactionApplication" class="govuk-radios__input"
                   id="land-transaction-application-yes" type="radio" value="@nameof(SignificantChangeGenericYesNoNa.Yes)" />
            <label class="govuk-label govuk-radios__label" for="land-transaction-application-yes">
               Yes
            </label>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.LandTransactionApplication" class="govuk-radios__input"
                  aria-controls="conditional-land-transaction-application-no"
                  id="land-transaction-application-no" type="radio" value="@nameof(SignificantChangeGenericYesNoNa.No)" />
            <label class="govuk-label govuk-radios__label" for="land-transaction-application-no">
               No
            </label>
         </div>

         <div class="govuk-radios__conditional" id="conditional-land-transaction-application-no">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="LandTransactionApplicationAdditionalInfo">
                  Give Details
               </label>
               <inline-error for="@nameof(Model.LandTransactionApplicationAdditionalInfo)" />
               <textarea asp-for="@Model.LandTransactionApplicationAdditionalInfo"
                           class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.LandTransactionApplicationAdditionalInfo))"
                           rows="5" id="LandTransactionApplicationAdditionalInfo"></textarea>
            </div>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.LandTransactionApplication" class="govuk-radios__input"
                   id="land-transaction-application-na" type="radio" value="@nameof(SignificantChangeGenericYesNoNa.NotApplicable)" />
            <label class="govuk-label govuk-radios__label" for="land-transaction-application-na">
               Not Applicable
            </label>
         </div>
         
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset" data-test="land-transction-consent-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Have the Land Transaction Team consented to the change?
      </legend>
      <inline-error for="@nameof(Model.LandTransactionConsent)" />

      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="@Model.LandTransactionConsent" class="govuk-radios__input"
                   id="land-transaction-consent-yes" type="radio" value="@nameof(SignificantChangeGenericYesNoNa.Yes)" />
            <label class="govuk-label govuk-radios__label" for="land-transaction-consent-yes">
               Yes
            </label>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.LandTransactionConsent" class="govuk-radios__input"
                  aria-controls="conditional-land-transaction-consent-no"
                  id="land-transaction-consent-awaiting-ltt" type="radio" value="@nameof(SignificantChangeGenericYesNoNa.No)" />
            <label class="govuk-label govuk-radios__label" for="land-transaction-consent-awaiting-ltt">
               No
            </label>
         </div>

         <div class="govuk-radios__conditional" id="conditional-land-transaction-consent-no">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="LandTransactionConsentAdditionalInfo">
                  Give Details
               </label>
               <inline-error for="@nameof(Model.LandTransactionConsentAdditionalInfo)" />
               <textarea asp-for="@Model.LandTransactionConsentAdditionalInfo"
                           class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.LandTransactionConsentAdditionalInfo))"
                           rows="5" id="LandTransactionConsentAdditionalInfo"></textarea>
            </div>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.LandTransactionConsent" class="govuk-radios__input"
                   id="land-transaction-consent-na" type="radio" value="@nameof(SignificantChangeGenericYesNoNa.NotApplicable)" />
            <label class="govuk-label govuk-radios__label" for="land-transaction-consent-na">
               Not Applicable
            </label>
         </div>
         
      </div>
   </fieldset>
</div>
<div class="govuk-form-group">
   <fieldset class="govuk-fieldset" data-test="supporting-evidence-fieldset">
      <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label govuk-label--m" for="supporting-evidence">
                  Supporting Evidence
               </label>
               <inline-error for="@nameof(Model.LandTransactionSupportingEvidence)" />
               <input asp-for="@Model.LandTransactionSupportingEvidence"
                           class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.LandTransactionSupportingEvidence))"
                           type="text" id="supporting-evidence"
                           placeholder="e.g. https://sharepoint.edu.gov.uk/evidence"
                           >
               </input>
            </div>
   </fieldset>
</div>
