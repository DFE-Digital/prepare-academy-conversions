@page "/significant-change/task-list/{id:int}/religious-bodies"
@using Dfe.PrepareConversions.Data.Models.SignificantChange
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.ReligiousBodyConsultation.IndexModel
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Have any relevant religious bodies been consulted about this significant change?
      </legend>
      <inline-error for="@nameof(Model.TrustConsultedReligiousBody)" />
      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="TrustConsultedReligiousBody" class="govuk-radios__input" id="religious-bodies-consulted-yes"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.Yes)" data-test="religious-bodies-consulted-yes" />
            <label class="govuk-label govuk-radios__label" for="religious-bodies-consulted-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="TrustConsultedReligiousBody" class="govuk-radios__input" id="religious-bodies-consulted-no"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.No)"
                   aria-controls="conditional-religious-bodies-consulted-no" data-test="religious-bodies-consulted-no" />
            <label class="govuk-label govuk-radios__label" for="religious-bodies-consulted-no">No</label>
         </div>
         <div class="govuk-radios__conditional" id="conditional-religious-bodies-consulted-no">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="TrustConsultedReligiousBodyNotConsultedReason">Add details</label>
               <inline-error for="@nameof(Model.TrustConsultedReligiousBodyNotConsultedReason)" />
               <textarea asp-for="TrustConsultedReligiousBodyNotConsultedReason"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.TrustConsultedReligiousBodyNotConsultedReason))"
                         rows="5" data-test="religious-bodies-consulted-reason"></textarea>
            </div>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="TrustConsultedReligiousBody" class="govuk-radios__input" id="religious-bodies-consulted-not-applicable"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.NotApplicable)" data-test="religious-bodies-consulted-not-applicable" />
            <label class="govuk-label govuk-radios__label" for="religious-bodies-consulted-not-applicable">Not applicable</label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Has a religious body raised an objection to this significant change?
      </legend>
      <inline-error for="@nameof(Model.ReligiousBodyRaisedObjection)" />
      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="ReligiousBodyRaisedObjection" class="govuk-radios__input" id="religious-body-objection-yes"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.Yes)" data-test="religious-body-objection-yes"
                   aria-controls="conditional-religious-body-objection-yes" />
            <label class="govuk-label govuk-radios__label" for="religious-body-objection-yes">Yes</label>
         </div>
         <div class="govuk-radios__conditional" id="conditional-religious-body-objection-yes">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="ReligiousBodyRaisedObjectionReason">Add details</label>
               <inline-error for="@nameof(Model.ReligiousBodyRaisedObjectionReason)" />
               <textarea asp-for="ReligiousBodyRaisedObjectionReason"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.ReligiousBodyRaisedObjectionReason))"
                         rows="5" data-test="religious-body-objection-reason"></textarea>
            </div>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="ReligiousBodyRaisedObjection" class="govuk-radios__input" id="religious-body-objection-no"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.No)"
                   data-test="religious-body-objection-no" />
            <label class="govuk-label govuk-radios__label" for="religious-body-objection-no">No</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="ReligiousBodyRaisedObjection" class="govuk-radios__input" id="religious-body-objection-not-applicable"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.NotApplicable)" data-test="religious-body-objection-not-applicable" />
            <label class="govuk-label govuk-radios__label" for="religious-body-objection-not-applicable">Not applicable</label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Has consent been granted by relevant religious bodies?
      </legend>
      <inline-error for="@nameof(Model.ReligiousBodyConsentGranted)" />
      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="ReligiousBodyConsentGranted" class="govuk-radios__input" id="religious-body-consent-yes"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.Yes)" data-test="religious-body-consent-yes" />
            <label class="govuk-label govuk-radios__label" for="religious-body-consent-yes">Yes</label>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="ReligiousBodyConsentGranted" class="govuk-radios__input" id="religious-body-consent-no"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.No)"
                   aria-controls="conditional-religious-body-consent-no" data-test="religious-body-consent-no" />
            <label class="govuk-label govuk-radios__label" for="religious-body-consent-no">No</label>
         </div>
         <div class="govuk-radios__conditional" id="conditional-religious-body-consent-no">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="ReligiousBodyConsentNotGrantedReason">Add details</label>
               <inline-error for="@nameof(Model.ReligiousBodyConsentNotGrantedReason)" />
               <textarea asp-for="ReligiousBodyConsentNotGrantedReason"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.ReligiousBodyConsentNotGrantedReason))"
                         rows="5" data-test="religious-body-consent-reason"></textarea>
            </div>
         </div>
         <div class="govuk-radios__item">
            <input asp-for="ReligiousBodyConsentGranted" class="govuk-radios__input" id="religious-body-consent-not-applicable"
                   type="radio" value="@nameof(YesNoNotApplicableAnswer.NotApplicable)" data-test="religious-body-consent-not-applicable" />
            <label class="govuk-label govuk-radios__label" for="religious-body-consent-not-applicable">Not applicable</label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <label class="govuk-label govuk-label--m" for="SupportingEvidence">Supporting evidence</label>
   <div class="govuk-hint">Add a link to supporting evidence.</div>
   <input asp-for="SupportingEvidence" class="govuk-input" type="text" data-test="religious-bodies-supporting-evidence" />
</div>
