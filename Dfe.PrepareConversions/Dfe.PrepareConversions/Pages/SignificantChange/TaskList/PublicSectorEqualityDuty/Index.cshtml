@page "/significant-change/task-list/{id:int}/public-sector-equality-duty"
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.PublicSectorEqualityDuty.IndexModel
@using Dfe.PrepareConversions.Data.Models.SignificantChange
@{
   Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
   <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
      class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Has the Public Sector Equality Duty been considered and an Equalities Impact Assessment been completed?
      </legend>
      <inline-error for="@nameof(Model.EqualitiesImpactAssessmentCompleted)" />

      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="@Model.EqualitiesImpactAssessmentCompleted" class="govuk-radios__input"
                       id="assessment-completed-yes" type="radio" value="true"
                   data-test="assessment-completed-yes" />
                <label class="govuk-label govuk-radios__label" for="assessment-completed-yes">
               Yes
            </label>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.EqualitiesImpactAssessmentCompleted" class="govuk-radios__input"
                       id="assessment-completed-no" type="radio" value="false"
                       data-test="assessment-completed-no" />
                <label class="govuk-label govuk-radios__label" for="assessment-completed-no">
               No
            </label>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
   <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
         Is the decision likely to disproportionately affect any particular person or group who share protected characteristics?
      </legend>
      <inline-error for="@nameof(Model.EqualitiesImpactIdentified)" />

      <div class="govuk-radios" data-module="govuk-radios">
         <div class="govuk-radios__item">
            <input asp-for="@Model.EqualitiesImpactIdentified" class="govuk-radios__input"
                   id="equalities-impact-unlikely" type="radio" value="@EqualitiesImpact.Unlikely"
                   data-test="equalities-impact-unlikely" />
            <label class="govuk-label govuk-radios__label" for="equalities-impact-unlikely">
               Unlikely
            </label>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.EqualitiesImpactIdentified" class="govuk-radios__input"
                   id="equalities-impact-some" type="radio" value="@EqualitiesImpact.SomeImpact"
                   aria-controls="conditional-equalities-some"
                   data-test="equalities-impact-some" />
            <label class="govuk-label govuk-radios__label" for="equalities-impact-some">
               Some impact
            </label>
         </div>

         <div class="govuk-radios__conditional" id="conditional-equalities-some">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="EqualitiesSomeImpactDetails">
                  Use this area for additional information relating to mitigations, actions and further investigations.
               </label>
               <inline-error for="@nameof(Model.SomeImpactDetails)" />
               <textarea asp-for="@Model.SomeImpactDetails" id="EqualitiesSomeImpactDetails"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.SomeImpactDetails))"
                         rows="5" data-test="some-impact-details"></textarea>
            </div>
         </div>

         <div class="govuk-radios__item">
            <input asp-for="@Model.EqualitiesImpactIdentified" class="govuk-radios__input"
                   id="equalities-impact-likely" type="radio" value="@EqualitiesImpact.Likely"
                   aria-controls="conditional-equalities-likely"
                   data-test="equalities-impact-likely" />
            <label class="govuk-label govuk-radios__label" for="equalities-impact-likely">
               Likely
            </label>
         </div>

         <div class="govuk-radios__conditional" id="conditional-equalities-likely">
            <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
               <label class="govuk-label" for="EqualitiesLikelyDetails">
                  Use this area for additional information relating to mitigations, actions and further investigations.
               </label>
               <inline-error for="@nameof(Model.LikelyDetails)" />
               <textarea asp-for="@Model.LikelyDetails" id="EqualitiesLikelyDetails"
                         class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.LikelyDetails))"
                         rows="5" data-test="which-groups-affected"></textarea>
            </div>
         </div>
      </div>
   </fieldset>
</div>

<div class="govuk-form-group">
    <label class="govuk-label" for="SupportingEvidence">
        Supporting evidence
    </label>
    <input asp-for="@Model.SupportingEvidence" class="govuk-input" type="text" data-test="psed-supporting-evidence" />
</div>
