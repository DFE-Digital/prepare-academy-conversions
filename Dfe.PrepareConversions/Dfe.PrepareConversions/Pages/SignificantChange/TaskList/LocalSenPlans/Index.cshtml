@page "/significant-change/task-list/{id:int}/local-sen-plans"
@using Dfe.PrepareConversions.Data.Models.SignificantChange
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.LocalSenPlans.IndexModel
@{
    Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
    <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
       class="govuk-back-link">Back</a>
}

<div class="govuk-form-group @ModelState.GetErrorStyleClass()">
    <fieldset class="govuk-fieldset" id="Answer">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
            Does the proposal conflict with a Local SEN Reform Plan (or equivalent) for SEN, AP and high needs provision?
        </legend>

        <inline-error for="@nameof(Model.Answer)" />

        <div class="govuk-radios" data-module="govuk-radios">
            <div class="govuk-radios__item">
                <input asp-for="@Model.Answer" class="govuk-radios__input"
                       id="answer-yes" type="radio"
                       value="@nameof(YesNoNotApplicableAnswer.Yes)"
                       aria-controls="conditional-additional-information"
                       data-test="answer-yes" />
                <label class="govuk-label govuk-radios__label" for="answer-yes">Yes</label>
            </div>

            <div class="govuk-radios__conditional" id="conditional-additional-information">
                <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
                    <label class="govuk-label" for="AdditionalInformation">Give details</label>
                    <inline-error for="@nameof(Model.AdditionalInformation)" />
                    <textarea asp-for="@Model.AdditionalInformation"
                              class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.AdditionalInformation))"
                              rows="5" data-test="additional-information"></textarea>
                </div>
            </div>

            <div class="govuk-radios__item">
                <input asp-for="@Model.Answer" class="govuk-radios__input"
                       id="answer-no" type="radio"
                       value="@nameof(YesNoNotApplicableAnswer.No)"
                       data-test="answer-no" />
                <label class="govuk-label govuk-radios__label" for="answer-no">No</label>
            </div>

            <div class="govuk-radios__item">
                <input asp-for="@Model.Answer" class="govuk-radios__input"
                       id="answer-not-applicable" type="radio"
                       value="@nameof(YesNoNotApplicableAnswer.NotApplicable)"
                       data-test="not-applicable" />
                <label class="govuk-label govuk-radios__label" for="answer-not-applicable">Not applicable</label>
            </div>
        </div>
    </fieldset>
</div>

<supporting-evidence-input asp-for="@Model.SupportingEvidence" data-test="supporting-evidence" />
