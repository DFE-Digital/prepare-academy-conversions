@page "/significant-change/task-list/{id:int}/special-school-satellite-considerations"
@using Dfe.PrepareConversions.Data.Models.SignificantChange
@model Dfe.PrepareConversions.Pages.SignificantChange.TaskList.SpecialSchoolSatelliteConsiderations.IndexModel
@{
    Layout = "_SignificantChangeTaskLayout";
}

@section BeforeMain
{
    <a asp-page="@Links.SignificantChange.SignificantChangeTaskList.Page" asp-route-id="@Model.Project.Id"
       class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
    <fieldset class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
           Does the proposal meet the requirements set out for satellite sites in the operational guidance?
        </legend>

        <inline-error for="@nameof(Model.Answer)" />

        <div class="govuk-radios" data-module="govuk-radios">
            <div class="govuk-radios__item">
                <input asp-for="@Model.Answer" class="govuk-radios__input"
                       id="answer-yes" type="radio"
                       value="@nameof(FundingAnswer.Yes)"
                       data-test="answer-yes" />
                <label class="govuk-label govuk-radios__label" for="answer-yes">
                    Yes
                </label>
            </div>

            <div class="govuk-radios__item">
                <input asp-for="@Model.Answer" class="govuk-radios__input"
                       id="answer-no" type="radio"
                       value="@nameof(FundingAnswer.No)"
                       aria-controls="conditional-additional-information"
                       data-test="additional-info" />
                <label class="govuk-label govuk-radios__label" for="answer-no">
                    No
                </label>
            </div>

            <div class="govuk-radios__conditional" id="conditional-additional-information">
                <div class="govuk-form-group @ModelState.GetErrorStyleClass()">
                    <label class="govuk-label" for="AdditionalInformation">
                        Use this area for additional information relating to mitigations, actions and further investigations.
                    </label>
                    <inline-error for="@nameof(Model.AdditionalInformation)" />
                    <textarea asp-for="@Model.AdditionalInformation"
                              class="govuk-textarea @ModelState.GetTextAreaErrorStyles(nameof(Model.AdditionalInformation))"
                              rows="5" data-test="funding-additional-information"></textarea>
                </div>
            </div>

            <div class="govuk-radios__item">
                <input asp-for="@Model.Answer" class="govuk-radios__input"
                       id="answer-not-applicable" type="radio"
                       value="@nameof(FundingAnswer.NotApplicable)"
                       data-test="funding-not-applicable" />
                <label class="govuk-label govuk-radios__label" for="answer-not-applicable">
                    Not applicable
                </label>
            </div>
        </div>
    </fieldset>
</div>

<supporting-evidence-input asp-for="@Model.SupportingEvidence" data-test="supporting-evidence" />