@page "/significant-change/project-list"
@model Dfe.PrepareConversions.Pages.SignificantChange.ProjectList.IndexModel
@{
    ViewData["Title"] = "Significant change projects";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-3" data-cy="select-heading">Significant change projects</h1>
        <p class="govuk-body-l">Find and manage existing significant change projects or create a new one.</p>

        <h2 class="govuk-heading-l" test-id="projectCount" data-cy="select-projectlist-filter-count">@(Model.TotalProjects) projects found</h2>

        <div if="@Model.ProjectCount == 0">
            <div class="govuk-heading-m govuk-!-margin-top-3" data-cy="select-significant-change-no-results">There are no matching results.</div>
        </div> 

        <div if="@Model.ProjectCount > 0">
            <div class="sort-component">
                <nav class="govuk-body sort-component__nav" aria-label="sort-by">
                    <span class="govuk-!-font-weight-bold">Sorted by:</span> Project created date
                </nav>
            </div>

            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Projects (@Model.ProjectCount)</caption>
                    <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th class="govuk-table__header app-!-width-three-fifths">Application information</th>
                    </tr>
                    </thead>
                <tbody class="govuk-table__body">
                @{
                    <partial name="Shared/_SignificantChangeProjectListRows" model="Model.Projects" />
                }
                </tbody>
            </table>

            <partial name="Shared/_Pagination" model="Model" />
        </div>
    </div>
</div>