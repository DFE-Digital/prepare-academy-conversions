
@page "/significant-change/{id:int}/decision/declined-reason"
@using Dfe.PrepareConversions.Data.Models.SignificantChange
@using Dfe.PrepareConversions.Extensions
@using Dfe.Academisation.ExtensionMethods
@model Dfe.PrepareConversions.Pages.SignificantChange.Decision.DeclineReasonModel
@{
   ViewData["Title"] = "Why project was declined";
}

@section BeforeMain
{
   <partial name="_BackLink" model="@Model.BackLinkModel"/>
   <partial name="_ErrorSummary"/>
}

<span id="selection-span" class="govuk-caption-l">Record the decision</span>
<h1 class="govuk-heading-l">Why was this project declined?</h1>

<form method="post">
   <div class="govuk-form-group">
      <fieldset class="govuk-fieldset">
         <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
         </legend>
         <div class="govuk-checkboxes @ModelState.GetErrorStyleClass()" data-module="govuk-checkboxes" id="WasReasonGiven">

            <input type="hidden" asp-for="@Model.WasReasonGiven"/>

            @{
               CheckBoxAndLabel(SignificantChangeDeclinedReason.Finance, Model.FinanceIsChecked, Model.FinanceDetails);
               CheckBoxAndLabel(SignificantChangeDeclinedReason.Performance, Model.PerformanceIsChecked, Model.PerformanceDetails);
               CheckBoxAndLabel(SignificantChangeDeclinedReason.Governance, Model.GovernanceIsChecked, Model.GovernanceDetails);
               CheckBoxAndLabel(SignificantChangeDeclinedReason.ChoiceOfTrust, Model.ChoiceOfTrustIsChecked, Model.ChoiceOfTrustDetails);
               CheckBoxAndLabel(SignificantChangeDeclinedReason.Other, Model.OtherIsChecked, Model.OtherDetails);
            }
         </div>
      </fieldset>
   </div>

   <button class="govuk-button" data-module="govuk-button" id="submit-btn">
      Continue
   </button>
</form>

@{
   void CheckBoxAndLabel(SignificantChangeDeclinedReason declinedReason, bool isChecked, string details)
   {
      <div class="govuk-checkboxes__item" id="@(declinedReason)Details">
         <input class="govuk-checkboxes__input" id="@declinedReason.ToString().ToLower()-checkbox" name="@(declinedReason)IsChecked" type="checkbox"
                data-aria-controls="conditional-@declinedReason" value="true" @(isChecked ? "checked" : "")>
         <label class="govuk-label govuk-checkboxes__label" for="@declinedReason.ToString().ToLower()-checkbox">
            @declinedReason.ToDescription()
         </label>
      </div>
      <div class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden" id="conditional-@declinedReason">
         <div class="govuk-form-group">
            <label class="govuk-label" for="@declinedReason.ToString().ToLower()-txtarea">
               Give reasons
            </label>
            <textarea class="govuk-textarea govuk-!-width-three-quarters" id="@declinedReason.ToString().ToLower()-txtarea"
                      name="@(declinedReason)Details" rows="5" aria-describedby="more-detail-hint">@details</textarea>
         </div>
      </div>
   }
}